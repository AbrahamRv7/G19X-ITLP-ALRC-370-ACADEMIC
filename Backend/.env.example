# Variables de Entorno - PluriOne LegalOps (Plantilla de ejemplo)

# 1. Base de datos (Debe coincidir con tu docker-compose.yml local)
# Reemplaza 'tu_password_de_docker' con la contraseña de tu contenedor
DATABASE_URL=postgresql://postgres:tu_password_de_docker@localhost:5432/plurione_db

# 2. Seguridad JWT (Usa una clave aleatoria para desarrollo)
SECRET_KEY=escribe_aqui_una_clave_secreta_para_pruebas_locales
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Administrador Inicial (Usuario de prueba local)
INITIAL_ADMIN_EMAIL=admin_local@plurione.com
INITIAL_ADMIN_PASSWORD=AdminPrueba123!

# 4. Entorno de ejecución
PYTHON_VERSION=3.12.8